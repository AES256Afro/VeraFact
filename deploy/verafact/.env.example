# Copy to .env and fill in. Keep .env out of git.

# A long random string. Generate one with: openssl rand -base64 33
SEARXNG_SECRET=

# The address users reach the instance at, with the port if any.
SEARXNG_BASE_URL=https://<your-host>.<your-tailnet>.ts.net:8899

# Where the container listens on the host. Loopback by default; Tailscale Serve
# publishes it to the tailnet.
VERAFACT_HOST=127.0.0.1
VERAFACT_PORT=8899

# Image tag produced by build.sh.
VERAFACT_IMAGE=verafact:dev

# The model layer (off by default). openai_compat is a local OpenAI-style server;
# with Ollama on this host: FORK_LLM_BACKEND=openai_compat,
# FORK_LLM_BASE_URL=http://host.docker.internal:11434/v1, FORK_LLM_MODEL=<a model ollama has>.
# anthropic / openai are frontier APIs and need FORK_LLM_API_KEY.
FORK_LLM_BACKEND=disabled
FORK_LLM_BASE_URL=
FORK_LLM_MODEL=
FORK_LLM_API_KEY=

# Optional: Google Fact Check Tools API key (adds one source; the six built-in ones need no key).
FORK_FACTCHECK_GOOGLE_API_KEY=
